#!/usr/bin/env python3
"""The player's command inside its container. Only /work (this player's view) is visible."""

import json
import sqlite3
import sys
from pathlib import Path

sys.path.insert(0, "/opt/arena")
from arena.policy import format_help, validate  # noqa: E402

WORK = Path("/work")
ROLE = (WORK / "role").read_text().strip()
USAGE = """usage:
  arena status                 round, your scores so far, and your current policy
  arena policy help            the policy format, your decisions, actions and features
  arena policy show            print your current policy
  arena policy set FILE        validate FILE (JSON) and make it your policy for the next round
  arena tables                 the tables you can query and their columns
  arena query "SQL"            run a read-only SQL query (SQLite) on your data, prints up to 200 rows"""


def main(args):
    if not args or args[0] in ("-h", "--help", "help"):
        print(USAGE)
    elif args[0] == "status":
        print((WORK / "status.md").read_text())
    elif args[:2] == ["policy", "help"]:
        print(format_help(ROLE))
    elif args[:2] == ["policy", "show"]:
        print((WORK / "policy.json").read_text())
    elif args[:2] == ["policy", "set"] and len(args) == 3:
        try:
            policy = json.loads(Path(args[2]).read_text())
        except Exception as error:
            sys.exit(f"could not read JSON from {args[2]}: {error}")
        errors = validate(policy, ROLE)
        if errors:
            sys.exit("policy NOT saved:\n" + "\n".join(f"  - {e}" for e in errors))
        (WORK / "policy.json").write_text(json.dumps(policy, indent=1))
        print("policy saved; it will be used for the next round")
    elif args[0] == "tables":
        db = sqlite3.connect(f"file:{WORK / 'data.db'}?mode=ro", uri=True)
        for (name,) in db.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name"):
            cols = [r[1] for r in db.execute(f"PRAGMA table_info({name})")]
            count = db.execute(f"SELECT count(*) FROM {name}").fetchone()[0]
            print(f"{name} ({count} rows): {', '.join(cols)}")
    elif args[0] == "query" and len(args) == 2:
        db = sqlite3.connect(f"file:{WORK / 'data.db'}?mode=ro", uri=True)
        try:
            cur = db.execute(args[1])
        except Exception as error:
            sys.exit(f"SQL error: {error}")
        print("\t".join(d[0] for d in cur.description or []))
        rows = cur.fetchmany(201)
        for row in rows[:200]:
            print("\t".join("" if v is None else str(v) for v in row))
        if len(rows) > 200:
            print("... (more than 200 rows; aggregate or add LIMIT)")
    else:
        sys.exit(USAGE)


if __name__ == "__main__":
    main(sys.argv[1:])
